# Direct OpenAI runs
OPENAI_API_KEY=

# OpenRouter-backed Terminus runs
OPENROUTER_API_KEY=

# Vertex/ADC-backed Gemini CLI runs. Do not set GEMINI_API_KEY or GOOGLE_API_KEY for ADC.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-agentic-abstention-sa.json
GOOGLE_CLOUD_PROJECT=agentic-abstention-494317
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
